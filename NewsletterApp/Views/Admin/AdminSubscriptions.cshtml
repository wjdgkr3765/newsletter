@{
    ViewData["Title"] = "구독";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="page-title mb-0">구독</h1>
    <select id="admin-subscriptions-gubun" class="form-select gubun-dropdown" aria-label="뉴스레터 종류">
        <option value="" selected>전체</option>
    </select>
</div>
<form id="admin-subscriptions-search" class="d-flex gap-2 mb-3" role="search">
    <input type="search" name="keyword" class="form-control search-input" placeholder="이름·이메일 검색" maxlength="50" aria-label="검색어">
    <button type="submit" class="btn btn-outline-secondary">검색</button>
</form>
<div id="admin-subscriptions-alert" hidden></div>
<div id="admin-subscriptions-list"></div>
<nav id="admin-subscriptions-pagination"></nav>
@section Scripts {
    <script src="~/js/admin_subscriptions.js" asp-append-version="true"></script>
}
