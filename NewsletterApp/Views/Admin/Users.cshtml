@{
    ViewData["Title"] = "회원 관리";
}
<h1 class="page-title">회원 관리</h1>
<form id="users-search" class="d-flex gap-2 mb-3" role="search">
    <input type="search" name="keyword" class="form-control search-input" placeholder="아이디·이름 검색" maxlength="50" aria-label="검색어">
    <button type="submit" class="btn btn-outline-secondary">검색</button>
</form>
<div id="users-alert" hidden></div>
<div id="users-list"></div>
<nav id="users-pagination"></nav>
@section Scripts {
    <script src="~/js/users.js" asp-append-version="true"></script>
}
