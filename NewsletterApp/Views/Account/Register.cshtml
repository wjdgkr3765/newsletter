@{
    Layout = "_GuestLayout";
    ViewData["Title"] = "회원가입";
}
<h1 class="guest-title mb-4">회원가입</h1>
<div id="register-error" class="alert alert-danger py-2" hidden></div>
<div class="mb-3">
    <label class="form-label" for="register-login-id">아이디</label>
    <input type="text" id="register-login-id" class="form-control" maxlength="20" autocomplete="username">
    <div id="register-login-id-check" class="check-text form-text mt-1" data-hint="영문 소문자+숫자 6~20자">영문 소문자+숫자 6~20자</div>
</div>
<div class="mb-3">
    <label class="form-label" for="register-password">비밀번호</label>
    <input type="password" id="register-password" class="form-control" maxlength="20" autocomplete="new-password">
    <div id="register-password-check" class="check-text form-text mt-1" data-hint="8~20자, 영문·숫자·특수문자 각 1자 이상">8~20자, 영문·숫자·특수문자 각 1자 이상</div>
</div>
<div class="mb-3">
    <label class="form-label" for="register-password-confirm">비밀번호 확인</label>
    <input type="password" id="register-password-confirm" class="form-control" maxlength="20" autocomplete="new-password">
    <div id="register-password-confirm-check" class="check-text"></div>
</div>
<div class="mb-3">
    <label class="form-label" for="register-email">이메일</label>
    <div class="input-group">
        <input type="email" id="register-email" class="form-control" maxlength="50" autocomplete="email">
        <button type="button" id="register-send-code" class="btn btn-outline-secondary" disabled>인증 코드 받기</button>
    </div>
    <div id="register-email-check" class="check-text"></div>
</div>
<div class="mb-3" id="register-code-area" hidden>
    <label class="form-label" for="register-code">인증 코드</label>
    <div class="input-group">
        <input type="text" id="register-code" class="form-control" placeholder="숫자 6자리" maxlength="6" inputmode="numeric">
        <span class="input-group-text text-danger" id="register-code-timer"></span>
        <button type="button" id="register-verify-code" class="btn btn-outline-secondary" disabled>확인</button>
    </div>
    <div id="register-code-check" class="check-text"></div>
</div>
<div class="mb-4">
    <label class="form-label" for="register-name">이름</label>
    <input type="text" id="register-name" class="form-control" maxlength="30" autocomplete="name">
    <div id="register-name-check" class="check-text form-text mt-1" data-hint="2~30자">2~30자</div>
</div>
<button type="button" id="register-submit" class="btn btn-primary w-100" disabled>가입하기</button>
<div class="text-center mt-3">
    이미 회원이신가요? <a href="/login">로그인</a>
</div>
@section Scripts {
    <script src="~/js/validation.js" asp-append-version="true"></script>
    <script src="~/js/register.js" asp-append-version="true"></script>
}
