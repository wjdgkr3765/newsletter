@{
    Layout = "_GuestLayout";
    ViewData["Title"] = "비밀번호 찾기";
}
<h1 class="guest-title mb-4">비밀번호 찾기</h1>
<div id="reset-error" class="alert alert-danger py-2" hidden></div>
<div class="mb-3">
    <label class="form-label" for="reset-login-id">아이디</label>
    <input type="text" id="reset-login-id" class="form-control" maxlength="20" autocomplete="username">
    <div id="reset-login-id-check" class="check-text"></div>
</div>
<div class="mb-3">
    <label class="form-label" for="reset-email">이메일</label>
    <div class="input-group">
        <input type="email" id="reset-email" class="form-control" maxlength="50" autocomplete="email">
        <button type="button" id="reset-send-code" class="btn btn-outline-secondary" disabled>인증 코드 받기</button>
    </div>
    <div id="reset-email-check" class="check-text"></div>
</div>
<div class="mb-3" id="reset-code-area" hidden>
    <label class="form-label" for="reset-code">인증 코드</label>
    <div class="input-group">
        <input type="text" id="reset-code" class="form-control" placeholder="숫자 6자리" maxlength="6" inputmode="numeric">
        <span class="input-group-text text-danger" id="reset-code-timer"></span>
        <button type="button" id="reset-verify-code" class="btn btn-outline-secondary" disabled>확인</button>
    </div>
    <div id="reset-code-check" class="check-text"></div>
</div>
<div id="reset-step2" hidden>
    <hr>
    <div class="mb-3">
        <label class="form-label" for="reset-new-password">새 비밀번호</label>
        <input type="password" id="reset-new-password" class="form-control" maxlength="20" autocomplete="new-password">
        <div id="reset-new-password-check" class="check-text form-text mt-1" data-hint="8~20자, 영문·숫자·특수문자 각 1자 이상">8~20자, 영문·숫자·특수문자 각 1자 이상</div>
    </div>
    <div class="mb-4">
        <label class="form-label" for="reset-new-password-confirm">새 비밀번호 확인</label>
        <input type="password" id="reset-new-password-confirm" class="form-control" maxlength="20" autocomplete="new-password">
        <div id="reset-new-password-confirm-check" class="check-text"></div>
    </div>
    <button type="button" id="reset-submit" class="btn btn-primary w-100" disabled>비밀번호 변경</button>
</div>
<div class="text-center mt-3">
    <a href="/login">로그인으로 돌아가기</a>
</div>
@section Scripts {
    <script src="~/js/validation.js" asp-append-version="true"></script>
    <script src="~/js/password_reset.js" asp-append-version="true"></script>
}
