@{
    Layout = "_GuestLayout";
    ViewData["Title"] = "로그인";
}
<h1 class="guest-title mb-4">뉴스레터 로그인</h1>
<div id="login-error" class="alert alert-danger py-2" hidden></div>
<form id="login-form" novalidate>
    <div class="mb-3">
        <input type="text" id="login-id" class="form-control" placeholder="아이디" maxlength="20" autocomplete="username">
        <div id="login-id-check" class="check-text"></div>
    </div>
    <div class="mb-3">
        <input type="password" id="login-password" class="form-control" placeholder="비밀번호" maxlength="20" autocomplete="current-password">
        <div id="login-password-check" class="check-text"></div>
    </div>
    <button type="submit" id="login-submit" class="btn btn-primary w-100">로그인</button>
</form>
<div class="d-flex justify-content-between mt-3">
    <a href="/register">회원가입</a>
    <a href="/password-reset">비밀번호 찾기</a>
</div>
@section Scripts {
    <script src="~/js/validation.js" asp-append-version="true"></script>
    <script src="~/js/login.js" asp-append-version="true"></script>
}
